# Copia este archivo como .env dentro de ai-backend.
# Completa OPENROUTER_API_KEY con tu clave y reinicia el servidor.

# Puerto del servidor de la práctica.
PORT=3000

# Dirección local donde escucha el servidor.
HOST=127.0.0.1

# Clave privada de OpenRouter (obligatoria para obtener respuestas).
# Ejemplo de formato: OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
OPENROUTER_API_KEY=

# Modelo utilizado en el documento.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Dirección local de la aplicación. Si cambias PORT, actualiza este valor.
APP_URL=http://localhost:3000

# Activar el agente de base de datos Sakila.
# Cambia a true después de configurar MySQL y un usuario con permiso SELECT.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sakila
DB_USER=sakila_agent
DB_PASSWORD=
